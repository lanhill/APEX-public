# How to cite APEX: the paper describing it (arXiv, 2026), which GitHub's "Cite this
# repository" offers. Once it is published in a journal, replace preferred-citation with the
# journal article (year an integer, doi without the https://doi.org/ prefix; volume and start,
# the first page or article number, may be added) and keep the preprint's DOI under identifiers.
cff-version: 1.2.0
message: "If you use APEX, please cite it as below."
type: software
title: "APEX: Agentic Platform for Ensemble eXploration"
abstract: >-
  An extensible platform for ensemble history matching, reservoir forecasting,
  uncertainty quantification, optimization and agent-driven decision support.
authors:
  - family-names: Luo
    given-names: Xiaodong
version: 0.1.1
license: GPL-3.0-or-later
repository-code: "https://github.com/lanhill/APEX-public"
keywords:
  - history matching
  - ensemble methods
  - data assimilation
  - reservoir simulation
  - optimization
preferred-citation:
  type: article
  title: "APEX: Agentic Platform for Ensemble eXploration"
  authors:
    - family-names: Luo
      given-names: Xiaodong
  journal: "arXiv preprint arXiv:2611.33450"
  year: 2026
  month: 11
  doi: "10.48550/arXiv.2611.33450"
  url: "https://arxiv.org/abs/2611.33450"
  identifiers:
    - type: other
      value: "arXiv:2611.33450"
      description: "The arXiv identifier (physics.geo-ph)"
