-- A small CO2STORE deck in the oil-gas form (brine is the oil phase), written for APEX's
-- tests: CO2 injected into brine at 40 C, with a capillary pressure (SGOF).
RUNSPEC
TITLE
 APEX CO2STORE OIL-GAS
DIMENS
 10 1 10 /
EQLDIMS
/
TABDIMS
/
OIL
GAS
CO2STORE
DISGAS
METRIC
START
 1 'JAN' 2020 /
WELLDIMS
 1 10 1 1 /
UNIFOUT
GRID
INIT
DX
 100*20 /
DY
 100*20 /
DZ
 100*5 /
TOPS
 10*1000 /
PORO
 100*0.3 /
PERMX
 100*500 /
PERMY
 100*500 /
PERMZ
 100*100 /
PROPS
ROCK
 100 1e-5 /
SGOF
 0    0    1    0
 0.1  0    0.6  5
 0.8  0.8  0    20 /
SALINITY
 0.6 /
SOLUTION
EQUIL
 1000 100 2000 0 900 0 1 1 0 /
RTEMPVD
 0    40
 2000 40 /
RSVD
 0    0
 2000 0 /
RPTRST
 BASIC=2 DEN /
SUMMARY
FPR
FGIR
SCHEDULE
RPTRST
 BASIC=2 DEN /
WELSPECS
 'INJ' 'G' 1 1 1* 'GAS' /
/
COMPDAT
 'INJ' 1 1 8 10 'OPEN' 1* 1* 0.2 /
/
WCONINJE
 'INJ' 'GAS' 'OPEN' 'RATE' 20000 1* 300 /
/
TSTEP
 4*90 /
END
